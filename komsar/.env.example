# Salin ke .env lalu isi nilainya. JANGAN commit .env.
# Buat nilai acak:  python -c "import secrets;print(secrets.token_hex(32))"
KOMSAR_SECRET_KEY=
# 32 byte base64:   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
KOMSAR_DB_MASTER_KEY=
# Kosong = SQLite lokal (instance/komsar.db). Neon: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
MAX_FILE_MB=10
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=2
# Dongle flashdisk: 1 = setiap request butuh heartbeat dongle (aktifkan setelah alur login dongle siap)
KOMSAR_REQUIRE_DONGLE=0
# Sesi dikunci bila heartbeat dongle terakhir lebih lama dari ini (detik)
DONGLE_HEARTBEAT_TIMEOUT=60
